{
  "framework": null,
  "installCommand": "npm --prefix shopflow ci",
  "buildCommand": "npm run build:hosted",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/downloads/ShopFlow-Android.apk",
      "destination": "https://github.com/Zorolefrerot/MATCHLY-PROJECT/releases/download/shopflow-test-v1.0.3/ShopFlow-Android.apk",
      "permanent": false
    },
    {
      "source": "/downloads/ShopFlow-Windows.exe",
      "destination": "https://github.com/Zorolefrerot/MATCHLY-PROJECT/releases/download/shopflow-test-v1.0.3/ShopFlow-Windows.exe",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/app/" }
      ]
    }
  ]
}
