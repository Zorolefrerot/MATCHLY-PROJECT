{
  "framework": null,
  "installCommand": "npm --prefix shopflow ci",
  "buildCommand": "npm run build:hosted",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/downloads/ShopFlow-Android.apk",
      "destination": "https://shopflow-drc.onrender.com/downloads/ShopFlow-Android.apk"
    },
    {
      "source": "/downloads/ShopFlow-Windows.exe",
      "destination": "https://shopflow-drc.onrender.com/downloads/ShopFlow-Windows.exe"
    }
  ],
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/app/" }
      ]
    }
  ]
}
