# Public browser configuration. The publishable key is intentionally public;
# never put a Supabase secret/service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://sgiyuxpzqyyquvvznomn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY

# Production Render redirect; must match Supabase Auth's allowed redirect list.
VITE_SUPABASE_AUTH_REDIRECT_URL=https://shopflow-drc.onrender.com/app/

# Enable a provider only after its OAuth app is configured in Supabase Auth.
VITE_SHOPFLOW_GOOGLE_OAUTH_ENABLED=false
VITE_SHOPFLOW_GITHUB_OAUTH_ENABLED=false
VITE_SHOPFLOW_FACEBOOK_OAUTH_ENABLED=false
