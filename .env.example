PORT=3000
# Neon pooled URL, copied privately into Render Environment. Never commit it.
DATABASE_URL=
# Local-only fallback. Render refuses to start without DATABASE_URL.
DATABASE_PATH=./data/idrem.sqlite
# Optional on Render: automatically derived from RENDER_EXTERNAL_URL.
PUBLIC_ORIGIN=
# First start creates the sole owner privately. Remove EMAIL/PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Hokage
# Optional HTTPS email provider for Render. Needs an authorized sender/domain.
# Without mail configuration, password recovery explicitly stays unavailable.
RESEND_API_KEY=
MAIL_FROM=
# SMTP works only outside Render Free (outbound SMTP ports are blocked there).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
