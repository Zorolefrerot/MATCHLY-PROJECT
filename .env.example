# ============================================================
#  Exemple de variables d'environnement (Render / local)
#  Copier en .env pour un usage local — NE JAMAIS COMMITTER .env
# ============================================================

# --- Authentification Facebook (PRIORITAIRE sur account.txt) ---
# Colle ici le tableau JSON de l'AppState sur UNE seule ligne,
# ou sa version encodée en base64.
FB_APPSTATE=

# Alternative : chemin d'un Secret File Render contenant l'AppState
# FB_APPSTATE_FILE=/etc/secrets/account.txt

# --- Bot ---
BOT_NAME=MERDI BOT
PREFIX=/
ADMIN_UID=100065927401614
# Administrateurs supplémentaires (UID séparés par des virgules)
# ADMIN_UIDS=
TZ_BOT=Africa/Kinshasa

# --- Serveur HTTP (Render fournit PORT automatiquement) ---
PORT=3000

# --- Options FCA ---
SELF_LISTEN=false
AUTO_MARK_READ=false
APPEAR_ONLINE=false

# --- Reconnexion ---
RECONNECT_ENABLED=true
RECONNECT_INITIAL_DELAY=5000
RECONNECT_MAX_DELAY=300000
RECONNECT_MAX_ATTEMPTS=0

# --- Divers ---
COMMAND_COOLDOWN=1500
BROADCAST_MAX_THREADS=20
BROADCAST_DELAY=900
DEBUG=0
