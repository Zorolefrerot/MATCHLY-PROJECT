{
  "name": "shopflow-windows-desktop",
  "version": "1.0.3",
  "private": true,
  "description": "ShopFlow Windows desktop wrapper",
  "author": "ShopFlow",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:windows": "node generate-icon.mjs && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "build": {
    "appId": "cd.shopflow.desktop",
    "productName": "ShopFlow",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "loading.html",
      "offline.html",
      "assets/shopflow.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/shopflow.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ShopFlow-Windows.exe"
    }
  }
}
